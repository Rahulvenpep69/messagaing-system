<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>F17 Dashboard - Excel Driven Charts</title>
    <!-- Bootstrap CSS via CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Chart.js via CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <!-- SheetJS via CDN -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <style>
        body { font-family: Arial, sans-serif; padding: 20px; background-color: #f8f9fa; }
        .container { max-width: 1200px; }
        .nav-tabs { margin-bottom: 20px; }
        .chart-container { height: 400px; margin-bottom: 30px; }
        #fileInput { margin-bottom: 20px; }
        .tab-pane { display: none; }
        .tab-pane.active { display: block; }
    </style>
</head>
<body>
    <div class="container">
        <h1 class="text-center mb-4">F17 Dashboard</h1>
        <p class="text-center">Upload your Excel file (F17_Dashboard_Data.xlsx) to view dynamic charts. Edit the Excel and re-upload to update.</p>
        
        <input type="file" id="fileInput" accept=".xlsx" class="form-control mb-3">
        
        <ul class="nav nav-tabs" id="dashboardTabs">
            <li class="nav-item"><a class="nav-link active" href="#businessMetrics">Business Metrics</a></li>
            <li class="nav-item"><a class="nav-link" href="#playerData">Player Data</a></li>
            <li class="nav-item"><a class="nav-link" href="#financialMetrics">Financial Metrics</a></li>
            <li class="nav-item"><a class="nav-link" href="#projectTasks">Project Tasks</a></li>
            <li class="nav-item"><a class="nav-link" href="#growthProjections">Growth Projections</a></li>
            <li class="nav-item"><a class="nav-link" href="#partnershipPipeline">Partnership Pipeline</a></li>
        </ul>
        
        <div class="tab-content">
            <div id="businessMetrics" class="tab-pane active">
                <h2>Business Metrics</h2>
                <canvas id="businessMetricsChart"></canvas>
            </div>
            <div id="playerData" class="tab-pane">
                <h2>Player Data</h2>
                <canvas id="playerDataChart"></canvas>
            </div>
            <div id="financialMetrics" class="tab-pane">
                <h2>Financial Metrics</h2>
                <canvas id="financialMetricsChart"></canvas>
            </div>
            <div id="projectTasks" class="tab-pane">
                <h2>Project Tasks</h2>
                <canvas id="projectTasksChart"></canvas>
            </div>
            <div id="growthProjections" class="tab-pane">
                <h2>Growth Projections</h2>
                <canvas id="growthProjectionsChart"></canvas>
            </div>
            <div id="partnershipPipeline" class="tab-pane">
                <h2>Partnership Pipeline</h2>
                <canvas id="partnershipPipelineChart"></canvas>
            </div>
        </div>
    </div>

    <script>
        let charts = {};
        let data = {};

        // Tab navigation
        document.querySelectorAll('.nav-link').forEach(link => {
            link.addEventListener('click', (e) => {
                e.preventDefault();
                document.querySelectorAll('.nav-link').forEach(l => l.classList.remove('active'));
                document.querySelectorAll('.tab-pane').forEach(p => p.classList.remove('active'));
                link.classList.add('active');
                document.querySelector(link.getAttribute('href')).classList.add('active');
            });
        });

        // File upload handler
        document.getElementById('fileInput').addEventListener('change', (event) => {
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = (e) => {
                    const workbook = XLSX.read(e.target.result, { type: 'binary' });
                    data = {};
                    workbook.SheetNames.forEach(sheetName => {
                        data[sheetName] = XLSX.utils.sheet_to_json(workbook.Sheets[sheetName]);
                    });
                    renderCharts();
                };
                reader.readAsBinaryString(file);
            }
        });

        function renderCharts() {
            // Destroy existing charts
            Object.values(charts).forEach(chart => chart.destroy());

            // Business Metrics Bar Chart
            if (data['Business Metrics']) {
                const bmLabels = data['Business Metrics'].map(row => row['Metric Name']);
                const bmCurrent = data['Business Metrics'].map(row => row['Current Value']);
                const bmTarget = data['Business Metrics'].map(row => row['Target Value']);
                charts.businessMetrics = new Chart(document.getElementById('businessMetricsChart'), {
                    type: 'bar',
                    data: {
                        labels: bmLabels,
                        datasets: [
                            { label: 'Current', data: bmCurrent, backgroundColor: '#007bff' },
                            { label: 'Target', data: bmTarget, backgroundColor: '#28a745' }
                        ]
                    },
                    options: { responsive: true, maintainAspectRatio: false }
                });
            }

            // Player Data Pie Chart
            if (data['Player Data']) {
                const pdLabels = data['Player Data'].map(row => row['Age Group']);
                const pdData = data['Player Data'].map(row => row['Current Players']);
                charts.playerData = new Chart(document.getElementById('playerDataChart'), {
                    type: 'pie',
                    data: {
                        labels: pdLabels,
                        datasets: [{ data: pdData, backgroundColor: ['#007bff', '#28a745', '#ffc107', '#dc3545', '#17a2b8'] }]
                    },
                    options: { responsive: true, maintainAspectRatio: false }
                });
            }

            // Financial Metrics Line Chart
            if (data['Financial Metrics']) {
                const fmLabels = data['Financial Metrics'].map(row => row['Month-Year']);
                const fmRevenue = data['Financial Metrics'].map(row => row['Gross Revenue']);
                const fmCosts = data['Financial Metrics'].map(row => row['Operating Costs']);
                const fmProfit = data['Financial Metrics'].map(row => row['Net Profit']);
                charts.financialMetrics = new Chart(document.getElementById('financialMetricsChart'), {
                    type: 'line',
                    data: {
                        labels: fmLabels,
                        datasets: [
                            { label: 'Revenue', data: fmRevenue, borderColor: '#28a745' },
                            { label: 'Costs', data: fmCosts, borderColor: '#dc3545' },
                            { label: 'Profit', data: fmProfit, borderColor: '#007bff' }
                        ]
                    },
                    options: { responsive: true, maintainAspectRatio: false }
                });
            }

            // Project Tasks Bar Chart
            if (data['Project Tasks']) {
                const ptLabels = data['Project Tasks'].map(row => row['Action Item']);
                const ptCompletion = data['Project Tasks'].map(row => row['Completion %']);
                charts.projectTasks = new Chart(document.getElementById('projectTasksChart'), {
                    type: 'bar',
                    data: {
                        labels: ptLabels,
                        datasets: [{ label: 'Completion %', data: ptCompletion, backgroundColor: '#ffc107' }]
                    },
                    options: { responsive: true, maintainAspectRatio: false }
                });
            }

            // Growth Projections Line Chart
            if (data['Growth Projections']) {
                const scenarios = [...new Set(data['Growth Projections'].map(row => row['Scenario']))];
                const months = [...new Set(data['Growth Projections'].map(row => row['Month']))];
                const datasets = scenarios.map(scenario => ({
                    label: scenario,
                    data: months.map(month => {
                        const row = data['Growth Projections'].find(r => r['Month'] === month && r['Scenario'] === scenario);
                        return row ? row['Projected Players'] : 0;
                    }),
                    borderColor: ['#007bff', '#28a745', '#ffc107'][scenarios.indexOf(scenario)]
                }));
                charts.growthProjections = new Chart(document.getElementById('growthProjectionsChart'), {
                    type: 'line',
                    data: { labels: months.map(m => `Month ${m}`), datasets },
                    options: { responsive: true, maintainAspectRatio: false }
                });
            }

            // Partnership Pipeline Bar Chart
            if (data['Partnership Pipeline']) {
                const ppLabels = data['Partnership Pipeline'].map(row => row['Partner Name']);
                const ppRevenue = data['Partnership Pipeline'].map(row => row['Expected Revenue']);
                charts.partnershipPipeline = new Chart(document.getElementById('partnershipPipelineChart'), {
                    type: 'bar',
                    data: {
                        labels: ppLabels,
                        datasets: [{ label: 'Expected Revenue', data: ppRevenue, backgroundColor: '#17a2b8' }]
                    },
                    options: { responsive: true, maintainAspectRatio: false }
                });
            }
        }
    </script>
</body>
</html>
